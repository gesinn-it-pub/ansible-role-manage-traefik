# {{ ansible_managed }}
# Disable update checks and usage report
global:
  checkNewVersion: false
  sendAnonymousUsage: false

entryPoints:
  web:
    address: ':80'
    http:
      redirections:
        entrypoint:
          to: websecure
          scheme: https
  websecure:
    address: ':443'

providers:
  docker:
    # Without explicitly setting the network here, traefik randomly
    # chooses one of the two IP addresses of the wiki services which
    # leads to random "gateway timout"s
    network: {{ manage_traefik_network }}
  file:
    directory: '/etc/traefik/dynamic'
    watch: true
{% if manage_traefik_dashboard_enabled | bool %}

# Published on 127.0.0.1 only, see docker-compose.yml
api:
  dashboard: true
  insecure: true
{% endif %}
{% if manage_traefik_acme_email | length > 0 %}

certificatesResolvers:
  {{ manage_traefik_acme_resolver }}:
    acme:
      email: {{ manage_traefik_acme_email }}
      storage: /etc/traefik/acme.json
      httpChallenge:
        entryPoint: web
{% endif %}
{% if manage_traefik_log_level | length > 0 %}

log:
  level: {{ manage_traefik_log_level }}

accessLog: {}
{% endif %}
