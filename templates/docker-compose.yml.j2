# {{ ansible_managed }}
services:
  traefik:
    image: traefik:{{ manage_traefik_version }}
    container_name: traefik
    restart: unless-stopped
    ports:
      - '80:80'
      - '443:443'
{% if manage_traefik_dashboard_enabled | bool %}
      - '127.0.0.1:8080:8080'
{% endif %}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - ./etc:/etc/traefik
{% if manage_traefik_extra_certs_folder | length > 0 %}
      - "{{ manage_traefik_extra_certs_folder }}:/etc/traefik/extra-certs"
{% endif %}
    labels:
      - "traefik.http.middlewares.no-contenttype-autodetect.contenttype.autodetect=false"
    environment:
      http_proxy: ""
      HTTP_PROXY: ""
      https_proxy: ""
      HTTPS_PROXY: ""

networks:
  default:
    external: true
    name: {{ manage_traefik_network }}
